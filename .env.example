# Verbatim configuration.
# Copy this file to ".env" (npm run setup does it for you) and edit the copy.
# Never commit .env — it can hold tokens and keys.

# ---------------------------------------------------------------------------
# Engines. Local mode is the private default: audio and text stay on this machine.
# Switching either one to "groq" sends data to a third-party cloud service.
# ---------------------------------------------------------------------------
TRANSCRIBE_ENGINE=local        # local | groq
LLM_ENGINE=ollama              # ollama | groq

# ---------------------------------------------------------------------------
# Local transcription (WhisperX) — used from Phase 2
# ---------------------------------------------------------------------------
WHISPER_MODEL=large-v3         # large-v3 | large-v3-turbo | medium | small
WHISPER_DEVICE=auto            # auto | cuda | cpu   (auto = GPU if available)
WHISPER_COMPUTE_TYPE=auto      # auto | float16 | int8_float16 | int8
                               # 6 GB GPU: int8_float16 is safest. CPU: int8.

# Hugging Face token for pyannote speaker separation — used from Phase 3.
# Accept the terms for pyannote/speaker-diarization-3.1 and
# pyannote/segmentation-3.0 first, then create a "read" token.
HF_TOKEN=

# ---------------------------------------------------------------------------
# Local AI interpretation (Ollama) — used from Phase 6
# ---------------------------------------------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b        # or llama3.1:8b

# ---------------------------------------------------------------------------
# Optional free cloud mode (Groq). Only used when an engine above is "groq".
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Storage and server
# ---------------------------------------------------------------------------
# Where audio and the SQLite database live. Relative paths are relative to the
# project folder. Keep this OUT of OneDrive/Dropbox/Google Drive folders,
# or session audio will be uploaded to that cloud. Example: C:/VerbatimData
DATA_DIR=data
APP_HOST=127.0.0.1             # keep 127.0.0.1 so only this computer can connect
APP_PORT=8000
