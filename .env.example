# Verbatim configuration.
# `npm run setup` copies this file to ".env" and fills in an encryption key for you.
# Never commit .env — it holds your keys and tokens.

# ---------------------------------------------------------------------------
# Engines. Local mode is the private default: audio and text stay on this machine.
# Switching either one to "groq" sends data to a third-party cloud service.
# ---------------------------------------------------------------------------
TRANSCRIBE_ENGINE=local        # local | groq
LLM_ENGINE=ollama              # ollama | groq

# ---------------------------------------------------------------------------
# Local transcription (WhisperX)
# ---------------------------------------------------------------------------
WHISPER_MODEL=large-v3         # large-v3 | large-v3-turbo | medium | small
WHISPER_DEVICE=auto            # auto | cuda | cpu   (auto = GPU if available)
WHISPER_COMPUTE_TYPE=auto      # auto | float16 | int8_float16 | int8
                               # auto picks int8_float16 on 6-8 GB GPUs, float16 on bigger ones, int8 on CPU
WHISPER_BATCH_SIZE=8           # lower to 4 or 2 if you see "out of memory"
VAD_METHOD=pyannote            # pyannote | silero — voice detection that skips non-speech noise
AUTO_LANGUAGES=en,hi,kn       # "Auto-detect" picks one of these (stops Hindi being read as Urdu)
ALIGN_MODEL_KN=                # optional wav2vec2 model id for Kannada word timings (none ships by default)

# Background noise reduction applied to every upload and recording.
# off | light (recommended) | strong (noisy rooms: fans, traffic, AC). Each session can override it.
NOISE_REDUCTION=light

# ---------------------------------------------------------------------------
# Speaker separation (pyannote) — always local
# Accept the terms for pyannote/speaker-diarization-3.1 and pyannote/segmentation-3.0
# on huggingface.co, then create a "read" access token and paste it here.
# ---------------------------------------------------------------------------
HF_TOKEN=
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

# Voice analysis: a second check of who said what, by comparing voice fingerprints.
# Works without HF_TOKEN too (then it decides the speakers on its own). Free model, runs locally.
VOICE_CHECK=true
VOICE_MODEL=pyannote/wespeaker-voxceleb-resnet34-LM

# ---------------------------------------------------------------------------
# Local AI interpretation (Ollama)
# ---------------------------------------------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b        # or llama3.1:8b
OLLAMA_NUM_CTX=8192            # context window; longer transcripts are summarised from the insights
LLM_TEMPERATURE=0.2

# ---------------------------------------------------------------------------
# Optional free cloud mode (Groq). Only used when an engine above is "groq".
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Privacy
# ---------------------------------------------------------------------------
# Audio is encrypted at rest with this key. KEEP A COPY SOMEWHERE SAFE:
# without it, encrypted recordings cannot be played or re-processed.
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Storage and server
# ---------------------------------------------------------------------------
# Where audio and the database live. Keep this OUT of OneDrive/Dropbox/Google Drive
# folders, or session audio is uploaded to that cloud. Example: D:/Verbatim/data
DATA_DIR=data
# Where speech models are downloaded (several GB). Empty = your user cache folder.
MODELS_DIR=
# Where the Python environment lives (several GB). Empty = backend/.venv
VENV_DIR=
APP_HOST=127.0.0.1             # keep 127.0.0.1 so only this computer can connect
APP_PORT=8000
